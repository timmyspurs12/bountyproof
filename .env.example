# BountyProof environment configuration
# Copy to .env and fill in. NEVER commit real values.

# ---- GenLayer ---------------------------------------------------------------
# Network preset: studionet | testnetBradbury | localnet
GENLAYER_NETWORK=studionet
# Optional RPC override (defaults to the preset's public RPC)
GENLAYER_RPC_URL=
# Private key of the operator account used by backend scripts (deploy, indexing).
# Only needed for scripts/deploy_contract.py; the web app signs with the user's wallet.
GENLAYER_PRIVATE_KEY=
# Filled automatically by scripts/deploy_contract.py
BOUNTYPROOF_CONTRACT_ADDRESS=
# Optional explorer override (defaults per network)
GENLAYER_EXPLORER_URL=

# ---- GitHub -----------------------------------------------------------------
# Optional. Server-side only, used by the evidence layer to avoid public rate limits.
# Never exposed to the frontend.
GITHUB_TOKEN=

# ---- Storage -----------------------------------------------------------------
# SQLite index location (discovery aid only; the contract is the source of truth)
BOUNTYPROOF_DB_PATH=data/bountyproof.db
